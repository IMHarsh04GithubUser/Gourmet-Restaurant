PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/gourmatgarden
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SECRET_KEY=replace-with-a-generated-random-secret
CLIENT_ORIGINS=http://localhost:5173,http://localhost:5174
# The original delivery fee was Rs 2; stored here in paise.
DELIVERY_FEE_PAISE=200
# Leave payment keys blank to run with COD only. Secret keys stay on the backend.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Optional reservation emails. Use a Gmail app password.
GMAIL_USER=
GMAIL_PASS=
# Used only by npm run create-admin. Remove ADMIN_PASSWORD after setup.
ADMIN_NAME=Garden Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Set only when a known reverse proxy sits in front of the API.
TRUST_PROXY_HOPS=
